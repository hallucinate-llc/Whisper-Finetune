# Dockerfile for Whisper-Finetune - Speech Model Training
FROM python:3.11-slim

# Install system dependencies including C build tools
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    curl \
    wget \
    pkg-config \
    libfftw3-dev \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd -m -s /bin/bash whisper-ft

WORKDIR /app

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    torch \
    torchvision \
    torchaudio \
    transformers \
    datasets \
    accelerate \
    tokenizers \
    fastapi \
    uvicorn \
    librosa \
    soundfile \
    whisper-openai \
    numpy \
    pandas

# Copy application code
COPY --chown=whisper-ft:whisper-ft . .

# Create necessary directories
RUN mkdir -p data models logs && chown -R whisper-ft:whisper-ft /app

USER whisper-ft

EXPOSE 4000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:4000/health || exit 1

# Create startup script
RUN echo '#!/bin/bash' > start.sh && \
    echo 'set -e' >> start.sh && \
    echo 'echo "Starting Whisper Fine-tune Service..."' >> start.sh && \
    echo '' >> start.sh && \
    echo '# Create a simple FastAPI server for model fine-tuning' >> start.sh && \
    echo 'cat > finetune_server.py << EOF' >> start.sh && \
    echo 'from fastapi import FastAPI' >> start.sh && \
    echo 'import os' >> start.sh && \
    echo '' >> start.sh && \
    echo 'app = FastAPI()' >> start.sh && \
    echo '' >> start.sh && \
    echo '@app.get("/health")' >> start.sh && \
    echo 'def health():' >> start.sh && \
    echo '    return {"status": "healthy"}' >> start.sh && \
    echo '' >> start.sh && \
    echo '@app.get("/")' >> start.sh && \
    echo 'def root():' >> start.sh && \
    echo '    return {"service": "whisper-finetune", "status": "ready for training"}' >> start.sh && \
    echo '' >> start.sh && \
    echo '@app.post("/finetune")' >> start.sh && \
    echo 'def start_finetune(config: dict):' >> start.sh && \
    echo '    return {"status": "finetuning_started", "config": config}' >> start.sh && \
    echo 'EOF' >> start.sh && \
    echo '' >> start.sh && \
    echo 'uvicorn finetune_server:app --host 0.0.0.0 --port 4000' >> start.sh && \
    chmod +x start.sh

CMD ["./start.sh"]